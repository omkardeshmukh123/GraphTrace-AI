# Run commands from the repository root. Settings also read backend/.env.
GRAPHTRACE_STORE=local
GRAPHTRACE_DATA_DIR=.data
GRAPHTRACE_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Your friend's synchronous parser: module:function (see docs/INTEGRATION.md).
GRAPHTRACE_PARSER=
# Required for writes in Neo4j mode; owns a single atomic graph transaction.
GRAPHTRACE_GRAPH_WRITER=
GRAPHTRACE_NEO4J_URI=bolt://localhost:7687
GRAPHTRACE_NEO4J_USERNAME=neo4j
GRAPHTRACE_NEO4J_PASSWORD=
GRAPHTRACE_NEO4J_DATABASE=neo4j
