## ─── GraphTrace AI — Unified .env ─────────────────────────────────────────────
## Copy this file to backend/.env and fill in your credentials.
##
## Two server modes:
##   M1+M2 standalone:  uvicorn backend.main:app --reload --port 8001
##   M3 full backend:   uvicorn backend.app.main:app --reload --port 8000
##
## Both read from this same .env file.

# ─── Storage mode for M3 backend ────────────────────────────────────────────
# local   → file-based JSON store (no Neo4j needed for testing)
# neo4j   → full Neo4j AuraDB / local Neo4j
GRAPHTRACE_STORE=local

# ─── M3 Parser plugin (our M1 integration) ───────────────────────────────────
# Uncomment after setting up Neo4j:
# GRAPHTRACE_PARSER=backend.artifact_intelligence.pipeline:parse_project

# ─── M3 Neo4j writer plugin (our M2 integration) ────────────────────────────
# GRAPHTRACE_GRAPH_WRITER=backend.knowledge_graph.graph_writer:write_graph

# ─── Neo4j AuraDB Credentials (used by both M2 and M3) ──────────────────────
# Get these from: https://console.neo4j.io → Create Free Instance
GRAPHTRACE_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
GRAPHTRACE_NEO4J_USERNAME=neo4j
GRAPHTRACE_NEO4J_PASSWORD=your_password_here
GRAPHTRACE_NEO4J_DATABASE=neo4j

# ─── M2 standalone config (our backend/main.py) ──────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ─── Upload limits ────────────────────────────────────────────────────────────
GRAPHTRACE_MAX_UPLOAD_BYTES=20971520    # 20 MB
GRAPHTRACE_MAX_EXTRACTED_BYTES=104857600  # 100 MB
GRAPHTRACE_MAX_FILES=2000

# ─── CORS origins (M4 React frontend) ────────────────────────────────────────
# GRAPHTRACE_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Local data directory (M3 local store) ───────────────────────────────────
GRAPHTRACE_DATA_DIR=.data
